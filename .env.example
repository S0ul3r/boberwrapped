# Boberwrapped - Spotify API credentials
# 1. Create app at https://developer.spotify.com/dashboard
# 2. Add Redirect URI: http://127.0.0.1:3000/callback
#    (Spotify may block localhost — use 127.0.0.1 and open the app at the same host)
# 3. Copy Client ID below

NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_client_id
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# Optional — Musixmatch lyrics (server-only, not exposed to browser)
# MUSIXMATCH_API_KEY=your_musixmatch_api_key
